# Downloads and unpacks a newer HXBot release next to the running one. hxbot-update.timer starts
# it; hxbot-update-apply.service moves the release into place at the next start of the server.
[Unit]
Description=Stage an HXBot update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/HXBot/hosted/hxbot-hosted-update stage
Nice=19
IOSchedulingClass=idle
CPUWeight=idle
TimeoutStartSec=30min
