# HXBot on a hosted server. provision.sh replaces @SERVICE_USER@ and enables this unit. boat
# stop and resume work like a reboot, so the unit starts again on each wake. boat starts the desktop
# about 8 seconds before the enabled units, and HXBot starts with it.
[Unit]
Description=HXBot hosted server
Wants=network-online.target hxbot-update-apply.service
After=network-online.target display-manager.service
# hxbot-boat-pre-stop stops HXBot before boat saves the disk, and makes this file so that nothing
# starts it again before the save. /run is empty at each boot.
ConditionPathExists=!/run/hxbot-pre-stop

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=hxbot
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/hxbot
# As root (+), and HXBot starts when it fails (-). It repairs the modes of the release, and installs
# the update request units when an older release moved this one into place; hxbot-hosted-update
# says why.
ExecStartPre=-+/opt/HXBot/hosted/hxbot-hosted-update trigger
ExecStart=/opt/HXBot/hosted/hxbot-hosted-server
# Stops HXBot before its virtual displays, so that it closes its database first.
ExecStop=/opt/HXBot/hosted/hxbot-hosted-server --stop
Restart=always
RestartSec=10
TimeoutStopSec=60
# Memory guards. The machine is small, and this unit holds HXBot, its browser tabs and every agent
# process. The OOM killer of the unit acts before the kernel's own, so the desktop, sshd and the boat
# agent keep running. systemd sets -500 as root, before it changes the user; main then gives each
# process it starts 500, so the OOM killer picks an agent process before main. One killed agent does
# not stop the unit: the default policy "stop" would stop HXBot too.
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target lightdm.service
