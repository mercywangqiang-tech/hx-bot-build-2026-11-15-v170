# boat stop and resume work like a reboot. This moves a staged release into place before HXBot
# starts, so an update never stops work in progress. While boat still restores the disk after a wake,
# the release stays, and HXBot asks for the install when no client uses it. HXBot does not require
# this unit, so it starts after a failure too. The next boot does the update again.
[Unit]
Description=Apply a staged HXBot update
Before=hxbot.service

[Service]
Type=oneshot
# hxbot.service wants this unit, and boat starts each enabled unit after a wake too. The second
# start must not copy a release under a running HXBot.
RemainAfterExit=yes
ExecStart=/opt/HXBot/hosted/hxbot-hosted-update boot
# At most 4 minutes of restore wait when a stop interrupted a copy, then the copy.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
