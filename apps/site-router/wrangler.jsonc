{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hxbot-site-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.sites.bot.hxallai.com/*",
      "zone_name": "sites.bot.hxallai.com"
    }
  ],
  "vars": {
    // The account service origin. The report route `/_hxbot/report` and the links on error pages use it.
    "ACCOUNT_ORIGIN": "https://bot.hxallai.com"
  },
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "hxbot-sites",
      "preview_bucket_name": "hxbot-sites-test"
    }
  ]
}
