# Applies the firewall of the HXBot instances before Docker starts their containers.
# `hxbot-instance setup` installs it. See docs/docker.md#several-instances-on-one-host.
[Unit]
Description=Firewall of the HXBot Docker instances
After=ufw.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/hxbot-docker/instances/hxbot-firewall

[Install]
WantedBy=multi-user.target docker.service
