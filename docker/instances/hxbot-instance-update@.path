# The app of instance %i asks for an update with an empty file in update-requests.
# `hxbot-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of HXBot instance %i

[Path]
PathExists=/srv/hxbot/%i/update-requests/update-stage
PathExists=/srv/hxbot/%i/update-requests/update-install

[Install]
WantedBy=paths.target
