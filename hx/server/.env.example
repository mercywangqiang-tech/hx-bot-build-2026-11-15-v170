# HXBot 服务器配置。
# 1. cp .env.example .env
# 2. 用 bash scripts/set-env.sh 填写服务器公网 IP，再按需要填写发信邮箱、阿里云短信和第三方登录（见部署文档第 5 节）
# 3. 运行 sh scripts/init-secrets.sh 自动生成全部密钥（会写回本文件，已有的值不会被覆盖）
# 本文件含密钥，权限应为 600，不要提交到任何代码仓库，也不要发到聊天工具里。

# ---------- 域名（与 hx/brand.json、nginx/hxbot.conf 保持一致，一般不用改） ----------
SITE_DOMAIN=bot.hxallai.com
API_DOMAIN=api.bot.hxallai.com
SIGNAL_DOMAIN=signal.bot.hxallai.com
TURN_DOMAIN=turn.bot.hxallai.com

# ---------- 必须填写 ----------
# 服务器公网 IPv4（阿里云 ECS 控制台“实例详情”里的公网 IP）
TURN_PUBLIC_IP=

# ---------- 注册与登录 ----------
# 每个人用邮箱和自己的密码登录。注册时填写用户名、密码、手机号码、职位、公司名称，默认要通过两项验证：
#   邮箱验证码  用下面的“发信邮箱”发出；HX_EMAIL_VERIFICATION=off 关闭（关闭后不能自助找回密码）
#   短信验证码  用下面的“阿里云短信”发出；HX_PHONE_VERIFICATION=off 关闭
# 留空 = 开启。开着验证却没填好对应的服务时，已注册的人照常登录，但不能注册新账号。
HX_EMAIL_VERIFICATION=
HX_PHONE_VERIFICATION=

# ---------- 发信邮箱（邮箱验证码、找回密码、主机邀请邮件） ----------
# 五项全部填好才启用。例：企业邮箱 bot@hxallai.com，SMTP 服务器 smtp.qiye.aliyun.com，端口只能是 465（SSL）。
# 密码用 bash scripts/set-env.sh --secret EMAIL_SMTP_PASSWORD 隐藏输入；填好后 bash scripts/set-env.sh --test-mail 测试。
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_FROM=
EMAIL_SMTP_PASSWORD=''

# ---------- 阿里云短信（短信验证码） ----------
# 四项全部填好才启用（申请步骤见部署文档 5.4 节）。只支持中国大陆手机号。
# Secret 用 bash scripts/set-env.sh --secret HX_SMS_ACCESS_KEY_SECRET 隐藏输入；填好后 bash scripts/set-env.sh --test-sms 手机号 发一条测试。
HX_SMS_ACCESS_KEY_ID=
HX_SMS_ACCESS_KEY_SECRET=
HX_SMS_SIGN_NAME=
HX_SMS_TEMPLATE_CODE=

# ---------- 第三方登录（可选；一家的各项都填好，这一家的按钮才出现） ----------
# 每一家都要先在它的开放平台用公司名义创建应用，回调地址统一是
#   https://bot.hxallai.com/api/browser/hx/oauth/<平台>/callback   （<平台> = wechat、alipay、douyin、apple、google、facebook）
# 申请步骤见部署文档 5.5 节和附录 A。密钥用 --secret 隐藏输入，密钥文件用 --file 读入。
# 微信开放平台（网站应用）
HX_WECHAT_APP_ID=
HX_WECHAT_APP_SECRET=
# 支付宝开放平台（网页应用）。私钥：bash scripts/set-env.sh --file HX_ALIPAY_PRIVATE_KEY 应用私钥文件
HX_ALIPAY_APP_ID=
HX_ALIPAY_PRIVATE_KEY=
# 抖音开放平台（网站应用）
HX_DOUYIN_CLIENT_KEY=
HX_DOUYIN_CLIENT_SECRET=
# Apple（Sign in with Apple）。还要填上面“iOS 版”里的 HX_APPLE_TEAM_ID。密钥：--file HX_APPLE_PRIVATE_KEY AuthKey_XXXX.p8
HX_APPLE_SERVICE_ID=
HX_APPLE_KEY_ID=
HX_APPLE_PRIVATE_KEY=
# Google（服务器在中国大陆时用不了：服务器连不上它的接口。只在境外服务器上开启）
HX_GOOGLE_CLIENT_ID=
HX_GOOGLE_CLIENT_SECRET=
# Facebook（同上，只在境外服务器上开启）
HX_FACEBOOK_APP_ID=
HX_FACEBOOK_APP_SECRET=

# ---------- 注册名单（可选） ----------
# 两项都留空：任何邮箱都可以注册。填了任意一项：只有名单内的邮箱能注册和登录。
# 例：HX_ALLOWED_EMAIL_DOMAINS=hxallai.com      例：HX_ALLOWED_EMAILS=a@qq.com,b@163.com
HX_ALLOWED_EMAIL_DOMAINS=
HX_ALLOWED_EMAILS=

# ---------- iOS 版、Apple 登录（可选） ----------
# 弘犀智能 Apple 开发者账号的团队号（10 位大写字母和数字，见 developer.apple.com → Membership）。
# 填好后，iPhone 上点邀请链接会直接打开 HXBot iOS 版；Apple 登录也用它。改后执行 docker compose up -d account。
HX_APPLE_TEAM_ID=

# ---------- 以前的共用登录口令（只在升级过渡时用） ----------
# 新部署留空。从“共用口令”版本升级上来的服务器：这一项原来有值。它不再能登录；只有在关闭了邮箱验证时，
# 以前用它登录过的邮箱第一次设置自己的密码要用它证明身份。大家都设好密码后清空：bash scripts/set-env.sh HX_LOGIN_PASSWORD ''
HX_LOGIN_PASSWORD=''

# ---------- 镜像源 ----------
# npm 包从国内镜像下载（海外服务器可改为 https://registry.npmjs.org）
NPM_REGISTRY=https://registry.npmmirror.com
# 构建账号服务镜像时安装根证书用的 Debian 镜像源（海外服务器可改为 deb.debian.org）
DEBIAN_MIRROR=mirrors.aliyun.com
# 基础镜像。按部署文档第 3.3 节配好加速源时保持默认；仍拉取失败时可改成带加速源前缀的地址
# （用 bash scripts/set-env.sh 修改），例如：
#   NODE_IMAGE=docker.1ms.run/library/node:24-bookworm-slim
#   BUN_IMAGE=docker.1ms.run/oven/bun:1.4.2-alpine
#   COTURN_IMAGE=docker.1ms.run/coturn/coturn:4.17.2-r0
#   CERTBOT_IMAGE=docker.1ms.run/certbot/certbot:latest
NODE_IMAGE=node:24-bookworm-slim
BUN_IMAGE=oven/bun:1.4.2-alpine
COTURN_IMAGE=coturn/coturn:4.17.2-r0
CERTBOT_IMAGE=certbot/certbot:latest

# ---------- 以下由 scripts/init-secrets.sh 自动生成，请勿手填 ----------
REMOTE_TICKET_KEY_ID=hxbot-remote-1
REMOTE_TICKET_PRIVATE_JWK=
REMOTE_TICKET_PUBLIC_JWKS=
REMOTE_AUTH_WEBHOOK_SECRET=
REMOTE_SESSION_SECRET=
REMOTE_METRICS_TOKEN=
TURN_SHARED_SECRET=
SKILLS_ADMIN_TOKEN=
SITE_REPORT_HASH_SECRET=
